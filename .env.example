# Copy to .env.local and fill in from your Supabase project
# (Supabase dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used by the seed loader and
# background import jobs that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket that holds the original uploaded R20 files (create it private)
R20_STORAGE_BUCKET=r20
